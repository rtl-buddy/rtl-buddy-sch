digraph hierarchy {
  rankdir="LR";
  compound=true;
  splines="ortho";
  nodesep=0.18;
  ranksep=1.2;
  fontname="Courier,monospace";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Courier,monospace", margin="0.4,0.06"];
  edge [fontname="Courier,monospace"];

  subgraph cluster_top {
    label="cdc_top  [clk_a, clk_b, clk_c]";
    labelloc="t";
    style="rounded";
    color="#94a3b8";
    penwidth=2;
    margin="20,20";
    { rank=source;
      "_in_clk_a" [shape=plaintext, label="clk_a ▶", fontsize=9];
      "_in_clk_b" [shape=plaintext, label="clk_b ▶", fontsize=9];
      "_in_clk_c" [shape=plaintext, label="clk_c ▶", fontsize=9];
      "_in_d_a" [shape=plaintext, label="  d_a ▶", fontsize=9];
      "_in_d_c" [shape=plaintext, label="  d_c ▶", fontsize=9];
    }
    { rank=sink;
      "_out_q_sync" [shape=plaintext, label="▶ q_sync     ", fontsize=9];
      "_out_q_flagged" [shape=plaintext, label="▶ q_flagged  ", fontsize=9];
      "_out_q_raw" [shape=plaintext, label="▶ q_raw      ", fontsize=9];
      "_out_q_unchecked" [shape=plaintext, label="▶ q_unchecked", fontsize=9];
      "_out_q_mix" [shape=plaintext, label="▶ q_mix      ", fontsize=9];
      "_out_q_dual" [shape=plaintext, label="▶ q_dual     ", fontsize=9];
      "_out_a_out" [shape=plaintext, label="▶ a_out      ", fontsize=9];
      "_out_b_out" [shape=plaintext, label="▶ b_out      ", fontsize=9];
    }
  subgraph cluster_cdc_top_u_bridge {
    label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD COLSPAN="2" ALIGN="LEFT">u_bridge</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">bridge</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">[clk_a, clk_b]</FONT></TD></TR></TABLE>>;
    labelloc="t";
    labeljust="l";
    style="rounded";
    color="#94a3b8";
    penwidth=1;
    "cdc_top.u_bridge" [shape=point, style=invis, width=0, height=0, group="cluster_top"];
  "cdc_top.u_bridge.u_ab" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD COLSPAN="2" ALIGN="LEFT">u_ab</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">sync2</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">[clk_b]</FONT></TD></TR></TABLE>>, style="rounded,striped", fillcolor="#dbeafe:#dcfce7", group="cluster_cdc_top_u_bridge"];
  "cdc_top.u_bridge.u_ba" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD COLSPAN="2" ALIGN="LEFT">u_ba</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">sync2</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">[clk_a]</FONT></TD></TR></TABLE>>, style="rounded,striped", fillcolor="#dcfce7:#dbeafe", group="cluster_cdc_top_u_bridge"];
  }
  "cdc_top.u_flagged" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD COLSPAN="2" ALIGN="LEFT">u_flagged</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">sync2</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">[clk_b]</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">⚠CDC: clk_a→clk_b</FONT></TD></TR></TABLE>>, style="rounded,striped", fillcolor="#dbeafe:#dcfce7", color="#dc2626", penwidth=2, fontcolor="#dc2626", group="cluster_top"];
  "cdc_top.u_sync" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD COLSPAN="2" ALIGN="LEFT">u_sync</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">sync2</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">[clk_b]</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">⚠CDC: clk_a→clk_b</FONT></TD></TR></TABLE>>, style="rounded,striped", fillcolor="#dbeafe:#dcfce7", color="#dc2626", penwidth=2, fontcolor="#dc2626", group="cluster_top"];
  "cdc_top.u_unchecked" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD COLSPAN="2" ALIGN="LEFT">u_unchecked</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">sync2</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">[clk_b]</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">⚠CDC: clk_a→clk_b</FONT></TD></TR></TABLE>>, style="rounded,striped", fillcolor="#dbeafe:#dcfce7", color="#dc2626", penwidth=2, fontcolor="#dc2626", group="cluster_top"];
  "cdc_top.u_dual" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BORDER="0" ALIGN="LEFT"><FONT FACE="Courier,monospace">u_dual<BR ALIGN="LEFT"/>mix2<BR ALIGN="LEFT"/>[clk_b]<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#dbeafe" PORT="src_clk_a" WIDTH="60"><FONT POINT-SIZE="10">clk_a</FONT></TD><TD BGCOLOR="#dcfce7" PORT="dst_clk_b" WIDTH="60"><FONT POINT-SIZE="10">clk_b</FONT></TD></TR><TR><TD BGCOLOR="#fef9c3" PORT="src_clk_c" WIDTH="60"><FONT POINT-SIZE="10">clk_c</FONT></TD><TD BGCOLOR="#dcfce7" PORT="dst_clk_b" WIDTH="60"><FONT POINT-SIZE="10">clk_b</FONT></TD></TR></TABLE>>, shape=plaintext, color="#dc2626", penwidth=2];
  "cdc_top.u_mix" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BORDER="0" ALIGN="LEFT"><FONT FACE="Courier,monospace">u_mix<BR ALIGN="LEFT"/>mix2<BR ALIGN="LEFT"/>[clk_b]<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#dbeafe" PORT="src_clk_a" WIDTH="60"><FONT POINT-SIZE="10">clk_a</FONT></TD><TD BGCOLOR="#dcfce7" PORT="dst_clk_b" WIDTH="60"><FONT POINT-SIZE="10">clk_b</FONT></TD></TR><TR><TD BGCOLOR="#fef9c3" PORT="src_clk_c" WIDTH="60"><FONT POINT-SIZE="10">clk_c</FONT></TD><TD BGCOLOR="#dcfce7" PORT="dst_clk_b" WIDTH="60"><FONT POINT-SIZE="10">clk_b</FONT></TD></TR></TABLE>>, shape=plaintext, color="#dc2626", penwidth=2];
  "cdc_top.u_raw" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD COLSPAN="2" ALIGN="LEFT">u_raw</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">ff</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">[clk_b]</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">⚠CDC: clk_a→clk_b</FONT></TD></TR></TABLE>>, style="rounded,striped", fillcolor="#dbeafe:#dcfce7", color="#dc2626", penwidth=2, fontcolor="#dc2626", group="cluster_top"];
  "cdc_top.u_src_a" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD COLSPAN="2" ALIGN="LEFT">u_src_a</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">ff</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">[clk_a]</FONT></TD></TR></TABLE>>, fillcolor="#dbeafe", group="cluster_top"];
  "cdc_top.u_src_c" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD COLSPAN="2" ALIGN="LEFT">u_src_c</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">ff</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">[clk_c]</FONT></TD></TR></TABLE>>, fillcolor="#fef9c3", group="cluster_top"];
    "cdc_top.u_bridge" -> "_out_a_out" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="a_out\l", fontsize=9, fontcolor="#475569", ltail="cluster_cdc_top_u_bridge"];
    "cdc_top.u_bridge" -> "_out_b_out" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="b_out\l", fontsize=9, fontcolor="#475569", ltail="cluster_cdc_top_u_bridge"];
    "cdc_top.u_dual" -> "_out_q_dual" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="q_dual\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_flagged" -> "_out_q_flagged" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="q_flagged\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_mix" -> "_out_q_mix" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="q_mix\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_raw" -> "_out_q_raw" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="q_raw\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_src_a" -> "cdc_top.u_bridge" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="a_q\l", fontsize=9, fontcolor="#475569", lhead="cluster_cdc_top_u_bridge"];
    "cdc_top.u_src_a" -> "cdc_top.u_dual" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="a_q\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_src_a" -> "cdc_top.u_flagged" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="a_q\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_src_a" -> "cdc_top.u_mix" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="a_q\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_src_a" -> "cdc_top.u_raw" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="a_q\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_src_a" -> "cdc_top.u_sync" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="a_q\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_src_a" -> "cdc_top.u_unchecked" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="a_q\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_src_c" -> "cdc_top.u_dual" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="c_q\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_src_c" -> "cdc_top.u_mix" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="c_q\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_sync" -> "cdc_top.u_bridge" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="q_sync\l", fontsize=9, fontcolor="#475569", lhead="cluster_cdc_top_u_bridge"];
    "cdc_top.u_sync" -> "_out_q_sync" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="q_sync\l", fontsize=9, fontcolor="#475569"];
    "cdc_top.u_unchecked" -> "_out_q_unchecked" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="q_unchecked\l", fontsize=9, fontcolor="#475569"];
    "_in_d_a" -> "cdc_top.u_src_a" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="d_a\l", fontsize=9, fontcolor="#475569"];
    "_in_d_c" -> "cdc_top.u_src_c" [color="#475569", penwidth=1.0, arrowsize=0.7, tailport=e, headport=w, xlabel="d_c\l", fontsize=9, fontcolor="#475569"];
    "_in_clk_a" -> "cdc_top.u_sync" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_flagged" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_raw" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_unchecked" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_mix" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_c" -> "cdc_top.u_mix" [label="⚠CDC: clk_c→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_dual" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_c" -> "cdc_top.u_dual" [label="⚠CDC: clk_c→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
  }
}
