digraph hierarchy {
  rankdir="LR";
  compound=true;
  splines="ortho";
  nodesep=0.18;
  ranksep=1.2;
  fontname="Courier,monospace";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", fontname="Courier,monospace", margin="0.4,0.06"];
  edge [fontname="Courier,monospace"];

  subgraph cluster_top {
    label="cdc_top  [clk_a, clk_b, clk_c]";
    labelloc="t";
    style="rounded";
    color="#94a3b8";
    penwidth=2;
    margin="20,20";
    { rank=source;
      "_in_clk_a" [shape=plaintext, label="clk_a ▶", fontsize=9];
      "_in_clk_b" [shape=plaintext, label="clk_b ▶", fontsize=9];
      "_in_clk_c" [shape=plaintext, label="clk_c ▶", fontsize=9];
      "_in_d_a" [shape=plaintext, label="  d_a ▶", fontsize=9];
      "_in_d_c" [shape=plaintext, label="  d_c ▶", fontsize=9];
    }
    { rank=sink;
      "_out_q_sync" [shape=plaintext, label="▶ q_sync     ", fontsize=9];
      "_out_q_flagged" [shape=plaintext, label="▶ q_flagged  ", fontsize=9];
      "_out_q_raw" [shape=plaintext, label="▶ q_raw      ", fontsize=9];
      "_out_q_unchecked" [shape=plaintext, label="▶ q_unchecked", fontsize=9];
      "_out_q_mix" [shape=plaintext, label="▶ q_mix      ", fontsize=9];
      "_out_q_dual" [shape=plaintext, label="▶ q_dual     ", fontsize=9];
      "_out_a_out" [shape=plaintext, label="▶ a_out      ", fontsize=9];
      "_out_b_out" [shape=plaintext, label="▶ b_out      ", fontsize=9];
    }
  subgraph cluster_cdc_top_u_bridge {
    label="u_bridge\lbridge\l[clk_a, clk_b]\l";
    labelloc="t";
    labeljust="l";
    style="rounded";
    color="#94a3b8";
    penwidth=1;
    "cdc_top.u_bridge" [shape=point, style=invis, width=0, height=0, group="cluster_top"];
  "cdc_top.u_bridge.u_ab" [label="u_ab\lsync2\l[clk_b]\l", style="rounded,striped", fillcolor="#dbeafe:#dcfce7", group="cluster_cdc_top_u_bridge"];
  "cdc_top.u_bridge.u_ba" [label="u_ba\lsync2\l[clk_a]\l", style="rounded,striped", fillcolor="#dcfce7:#dbeafe", group="cluster_cdc_top_u_bridge"];
  }
  "cdc_top.u_flagged" [label="u_flagged\lsync2\l[clk_b]\l\n⚠CDC: clk_a→clk_b", style="rounded,striped", fillcolor="#dbeafe:#dcfce7", color="#dc2626", penwidth=2, fontcolor="#dc2626", group="cluster_top"];
  "cdc_top.u_sync" [label="u_sync\lsync2\l[clk_b]\l\n⚠CDC: clk_a→clk_b", style="rounded,striped", fillcolor="#dbeafe:#dcfce7", color="#dc2626", penwidth=2, fontcolor="#dc2626", group="cluster_top"];
  "cdc_top.u_unchecked" [label="u_unchecked\lsync2\l[clk_b]\l\n⚠CDC: clk_a→clk_b", style="rounded,striped", fillcolor="#dbeafe:#dcfce7", color="#dc2626", penwidth=2, fontcolor="#dc2626", group="cluster_top"];
  "cdc_top.u_dual" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BORDER="0" ALIGN="LEFT"><FONT FACE="Courier,monospace">u_dual<BR ALIGN="LEFT"/>mix2<BR ALIGN="LEFT"/>[clk_b]<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#dbeafe" PORT="src_clk_a" WIDTH="60"><FONT POINT-SIZE="10">clk_a</FONT></TD><TD BGCOLOR="#dcfce7" PORT="dst_clk_b" WIDTH="60"><FONT POINT-SIZE="10">clk_b</FONT></TD></TR><TR><TD BGCOLOR="#fef9c3" PORT="src_clk_c" WIDTH="60"><FONT POINT-SIZE="10">clk_c</FONT></TD><TD BGCOLOR="#dcfce7" PORT="dst_clk_b" WIDTH="60"><FONT POINT-SIZE="10">clk_b</FONT></TD></TR></TABLE>>, shape=plaintext, color="#dc2626", penwidth=2];
  "cdc_top.u_mix" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BORDER="0" ALIGN="LEFT"><FONT FACE="Courier,monospace">u_mix<BR ALIGN="LEFT"/>mix2<BR ALIGN="LEFT"/>[clk_b]<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#dbeafe" PORT="src_clk_a" WIDTH="60"><FONT POINT-SIZE="10">clk_a</FONT></TD><TD BGCOLOR="#dcfce7" PORT="dst_clk_b" WIDTH="60"><FONT POINT-SIZE="10">clk_b</FONT></TD></TR><TR><TD BGCOLOR="#fef9c3" PORT="src_clk_c" WIDTH="60"><FONT POINT-SIZE="10">clk_c</FONT></TD><TD BGCOLOR="#dcfce7" PORT="dst_clk_b" WIDTH="60"><FONT POINT-SIZE="10">clk_b</FONT></TD></TR></TABLE>>, shape=plaintext, color="#dc2626", penwidth=2];
  "cdc_top.u_raw" [label="u_raw\lff\l[clk_b]\l\n⚠CDC: clk_a→clk_b", style="rounded,striped", fillcolor="#dbeafe:#dcfce7", color="#dc2626", penwidth=2, fontcolor="#dc2626", group="cluster_top"];
  "cdc_top.u_src_a" [label="u_src_a\lff\l[clk_a]\l", fillcolor="#dbeafe", group="cluster_top"];
  "cdc_top.u_src_c" [label="u_src_c\lff\l[clk_c]\l", fillcolor="#fef9c3", group="cluster_top"];
    "_in_clk_a" -> "cdc_top.u_bridge" [style=invis];
    "_in_clk_a" -> "cdc_top.u_mix" [style=invis];
    "_in_clk_a" -> "cdc_top.u_src_a" [style=invis];
    "cdc_top.u_bridge.u_ab" -> "cdc_top.u_flagged" [style=invis];
    "cdc_top.u_bridge.u_ab" -> "cdc_top.u_sync" [style=invis];
    "cdc_top.u_bridge.u_ab" -> "cdc_top.u_unchecked" [style=invis];
    "cdc_top.u_bridge.u_ab" -> "cdc_top.u_dual" [style=invis];
    "cdc_top.u_bridge.u_ab" -> "cdc_top.u_raw" [style=invis];
    "cdc_top.u_bridge.u_ab" -> "cdc_top.u_src_c" [style=invis];
    "_in_d_a" -> "cdc_top.u_src_a" [color="#dbeafe", penwidth=1.2, arrowsize=0.6, tailport=e];
    "_in_d_c" -> "cdc_top.u_src_c" [color="#fef9c3", penwidth=1.2, arrowsize=0.6, tailport=e];
    "cdc_top.u_sync" -> "_out_q_sync" [color="#dcfce7", penwidth=1.2, arrowsize=0.6, tailport=e, headport=w];
    "cdc_top.u_flagged" -> "_out_q_flagged" [color="#dcfce7", penwidth=1.2, arrowsize=0.6, tailport=e, headport=w];
    "cdc_top.u_raw" -> "_out_q_raw" [color="#dcfce7", penwidth=1.2, arrowsize=0.6, tailport=e, headport=w];
    "cdc_top.u_unchecked" -> "_out_q_unchecked" [color="#dcfce7", penwidth=1.2, arrowsize=0.6, tailport=e, headport=w];
    "cdc_top.u_mix" -> "_out_q_mix" [color="#dcfce7", penwidth=1.2, arrowsize=0.6, tailport=e, headport=w];
    "cdc_top.u_dual" -> "_out_q_dual" [color="#dcfce7", penwidth=1.2, arrowsize=0.6, tailport=e, headport=w];
    "cdc_top.u_bridge" -> "_out_q_sync" [color="#dbeafe", penwidth=1.2, arrowsize=0.6, tailport=e, headport=w, ltail="cluster_cdc_top_u_bridge"];
    "cdc_top.u_bridge" -> "_out_a_out" [color="#dbeafe", penwidth=1.2, arrowsize=0.6, tailport=e, headport=w, ltail="cluster_cdc_top_u_bridge"];
    "cdc_top.u_bridge" -> "_out_b_out" [color="#dbeafe", penwidth=1.2, arrowsize=0.6, tailport=e, headport=w, ltail="cluster_cdc_top_u_bridge"];
    "_in_clk_a" -> "cdc_top.u_sync" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_flagged" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_raw" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_unchecked" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_mix" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_c" -> "cdc_top.u_mix" [label="⚠CDC: clk_c→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_a" -> "cdc_top.u_dual" [label="⚠CDC: clk_a→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
    "_in_clk_c" -> "cdc_top.u_dual" [label="⚠CDC: clk_c→clk_b", color="#dc2626", style="dashed", fontcolor="#dc2626", tailport=e];
  }
}
